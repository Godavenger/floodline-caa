  "components": {
    "schemas": {
      "Body_attach_image_api_reports__report_id__image_post": {
        "properties": {
          "image": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "Image"
          }
        },
        "type": "object",
        "required": [
          "image"
        ],
        "title": "Body_attach_image_api_reports__report_id__image_post"
      },
      "DeliveryFault": {
        "properties": {
          "fail_next": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 0.0,
            "title": "Fail Next"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "fail_next"
        ],
        "title": "DeliveryFault"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IngestInput": {
        "properties": {
          "records": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "maxItems": 1000,
            "minItems": 1,
            "title": "Records"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "records"
        ],
        "title": "IngestInput"
      },
      "LoginInput": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "LoginInput"
      },
      "ModerationInput": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "verified",
              "rejected",
              "duplicate",
              "resolved"
            ],
            "title": "Status"
          },
          "reason": {
            "type": "string",
            "maxLength": 500,
            "minLength": 10,
            "title": "Reason"
          },
          "road_edge_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Road Edge Ids"
          },
          "ttl_minutes": {
            "type": "integer",
            "maximum": 360.0,
            "minimum": 15.0,
            "title": "Ttl Minutes",
            "default": 120
          },
          "duplicate_of": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duplicate Of"
          },
          "publish_image": {
            "type": "boolean",
            "title": "Publish Image",
            "default": false
          },
          "privacy_reviewed": {
            "type": "boolean",
            "title": "Privacy Reviewed",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "reason"
        ],
        "title": "ModerationInput"
      },
      "Point": {
        "properties": {
          "longitude": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Longitude"
          },
          "latitude": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Latitude"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "longitude",
          "latitude"
        ],
        "title": "Point"
      },
      "ReportCorrection": {
        "properties": {
          "description": {
            "type": "string",
            "maxLength": 800,
            "minLength": 10,
            "title": "Description"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "description"
        ],
        "title": "ReportCorrection"
      },
      "ReportInput": {
        "properties": {
          "longitude": {
            "type": "number",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Longitude"
          },
          "latitude": {
            "type": "number",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Latitude"
          },
          "description": {
            "type": "string",
            "maxLength": 800,
            "minLength": 10,
            "title": "Description"
          },
          "severity": {
            "type": "string",
            "enum": [
              "water_on_road",
              "slow_passage",
              "impassable",
              "unknown"
            ],
            "title": "Severity",
            "default": "unknown"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time",
            "title": "Observed At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "longitude",
          "latitude",
          "description",
          "observed_at"
        ],
        "title": "ReportInput"
      },
      "RouteInput": {
        "properties": {
          "start": {
            "$ref": "#/components/schemas/Point"
          },
          "end": {
            "$ref": "#/components/schemas/Point"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "start",
          "end"
        ],
        "title": "RouteInput"
      },
      "SubscriptionInput": {
        "properties": {
          "ward_id": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "title": "Ward Id"
          },
          "channel": {
            "type": "string",
            "const": "in_app",
            "title": "Channel",
            "default": "in_app"
          },
          "consented": {
            "type": "boolean",
            "const": true,
            "title": "Consented"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "ward_id",
          "consented"
        ],
        "title": "SubscriptionInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
